 };
 
 /** Nejvýš jednou za tolik se Cloudflare ptá, kdo vysílá. */
 const SYNC_THROTTLE_MS = 12 * 1000;
+/** Appka hlásí vysílání každých ~15 s; do tolika po posledním hlášení se vysílání bere jako živé, i když ho Cloudflare ještě (nebo už) nehlásí. */
+const APP_PING_FRESH_MS = 45 * 1000;
 /** Nový přenos do půl hodiny po posledním oznámení se odběratelům znovu nehlásí (výpadek, restart OBS). */
 const RENOTIFY_AFTER_MS = 30 * 60 * 1000;
 
@@ -229,6 +233,13 @@ export async function syncLiveStreams(options: { force?: boolean } = {}): Promis
             await supabaseServer.from('live_streams').update({ checked_at: nowIso }).eq('owner_id', row.owner_id);
           }
         } else if (row.is_live) {
+          if (appPingFresh(row)) {
+            // Appka hlásí, že vysílá - Cloudflare to jen ještě nepotvrdil (nebo krátce vypadl). Zůstává živě.
+            if (row.current_video_uid) {
