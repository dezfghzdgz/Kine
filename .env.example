# Supabase - najdeš v Supabase dashboardu -> Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Skutečná veřejná adresa appky (až bude appka nasazená) - appka to
# potřebuje pro sitemapu a náhledy odkazů. Do té doby klidně nech
# na http://localhost:3000.
NEXT_PUBLIC_SITE_URL=https://tvoje-domena.cz

# Cloudflare Stream - najdeš v Cloudflare dashboardu -> Stream
CLOUDFLARE_ACCOUNT_ID=your-account-id
CLOUDFLARE_STREAM_API_TOKEN=your-api-token

# Vlastní přehrávač hudby bere HLS z domény tvého účtu Cloudflare, kterou si
# sám přečte z adresy náhledu (customer-<kód>.cloudflarestream.com). Kdyby
# hudba nehrála, dá se kód nastavit i ručně (jen ten kód, bez "customer-"):
# NEXT_PUBLIC_STREAM_CUSTOMER_CODE=f33zs165nr7gyfy4

# Podepsané adresy pro neveřejná videa (nepovinné). Bez nich se nic
# nepodepisuje a appka se chová jako dřív. Postup, jak klíč vytvořit,
# je v lib/streamProtection.ts.
# CLOUDFLARE_STREAM_KEY_ID=id-podpisoveho-klice
# CLOUDFLARE_STREAM_KEY_PEM=base64-pem-tak-jak-ho-vrati-cloudflare

# GIFy v komentářích (nepovinné, appka bez toho zkusí sdílený klíč, který
# ale Giphy může kdykoliv zablokovat) - zdarma na developers.giphy.com
NEXT_PUBLIC_GIPHY_API_KEY=your-giphy-api-key
