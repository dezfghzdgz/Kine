# Supabase - najdeš v Supabase dashboardu -> Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Skutečná veřejná adresa appky (až bude appka nasazená) - appka to
# potřebuje pro sitemapu a náhledy odkazů. Do té doby klidně nech
# na http://localhost:3000.
NEXT_PUBLIC_SITE_URL=https://tvoje-domena.cz

# Cloudflare Stream - najdeš v Cloudflare dashboardu -> Stream
CLOUDFLARE_ACCOUNT_ID=your-account-id
CLOUDFLARE_STREAM_API_TOKEN=your-api-token

# Vlastní přehrávač hudby bere HLS z domény tvého účtu Cloudflare, kterou si
# sám přečte z adresy náhledu (customer-<kód>.cloudflarestream.com). Kdyby
# hudba nehrála, dá se kód nastavit i ručně (jen ten kód, bez "customer-"):
# NEXT_PUBLIC_STREAM_CUSTOMER_CODE=f33zs165nr7gyfy4

# Podepsané adresy pro neveřejná videa (nepovinné). Bez nich se nic
# nepodepisuje a appka se chová jako dřív. Postup, jak klíč vytvořit,
# je v lib/streamProtection.ts.
# CLOUDFLARE_STREAM_KEY_ID=id-podpisoveho-klice
# CLOUDFLARE_STREAM_KEY_PEM=base64-pem-tak-jak-ho-vrati-cloudflare

# GIFy v komentářích (nepovinné, appka bez toho zkusí sdílený klíč, který
# ale Giphy může kdykoliv zablokovat) - zdarma na developers.giphy.com
NEXT_PUBLIC_GIPHY_API_KEY=your-giphy-api-key
# GIFy pro appku do PC (překryvy v klipech) - klíč jen na serveru (/api/gifs/search); bez něj se vezme NEXT_PUBLIC_GIPHY_API_KEY
GIPHY_API_KEY=

# Limity nahrávání (všechno nepovinné, lib/uploadLimits.ts). Každá uložená
# minuta stojí u Cloudflare peníze, proto tu stropy jsou - až bude Kine větší,
# klidně zvedni. Kine Plus má 3x víc, tým Kine (admin / moderátor) bez stropu
# úložiště. Klipy vystřižené z cizích videí mají vlastní limit (lib/clips.ts).
# UPLOAD_DAILY_LIMIT=20          videí za 24 hodin
# UPLOAD_DAILY_MINUTES=240       minut videa za 24 hodin
# UPLOAD_MAX_VIDEO_MINUTES=120   nejdelší jedno video (minuty)
# UPLOAD_STORAGE_HOURS=30        kolik hodin videa smí mít kanál celkem
# UPLOAD_NEW_ACCOUNT_HOURS=24    jak dlouho platí přísnější limity nového účtu
# Nouzová brzda: 1 = teď nikdo nenahrává žádná videa (útok, plné úložiště).
# UPLOADS_PAUSED=1
# Kolik cizích videí si jeden účet stáhne do PC za 24 hodin (stahování MP4 se
# u Cloudflare platí jako přehrání):
# DOWNLOADS_PER_DAY=30

# Úklid (/api/videos/sweep, jednou denně z vercel.json): s CRON_SECRET ho může
# důkladně spustit jen Vercel (posílá ho sám), bez něj nejvýš jednou za hodinu.
# Vlastní náhodný text, třeba 32 znaků:
# CRON_SECRET=nahodny-dlouhy-text

# Živé vysílání (lib/liveLimits.ts): přenos delší než tolik hodin se ukončí
# a vysílat půjde zase za 15 minut; nezveřejněné záznamy se smažou po tolika dnech.
# LIVE_MAX_HOURS=12
# LIVE_RECORDING_KEEP_DAYS=7

# Appka Kine do PC (Kine jako aplikace + klipy ze hry). Instalátor staví
# GitHub Actions v repu kine-desktop a nahrává ho do našeho úložiště
# (Cloudflare R2) a záložně na GitHub Releases. /download/windows na něj
# pošle prohlížeč rovnou - uživatel nikam nechodí, jen mu začne stahování.
# Veřejná adresa složky v úložišti (tam leží Kine-Setup.exe,
# Kine-Clipper-Setup.exe a latest.yml) - stejná hodnota jako proměnná
# DESKTOP_DOWNLOAD_BASE v GitHubu repa kine-desktop. Bez ní se stahuje z GitHubu.
# NEXT_PUBLIC_DESKTOP_DOWNLOAD_BASE=https://pub-xxxxxxxx.r2.dev
# Když repo přejmenuješ:
# NEXT_PUBLIC_DESKTOP_REPO=dezfghzdgz/kine-desktop
# Přímá adresa jednoho instalátoru (přebije vše; druhý název se hledá vedle něj):
# NEXT_PUBLIC_DESKTOP_DOWNLOAD_URL=https://…/Kine-Setup.exe
# Nejstarší verze appky, která smí nahrávat na Kine a vysílat (lib/desktopClient.ts).
# Starší appka dostane "aktualizuj" a stáhne novou verzi. Platí, až je ta verze
# opravdu vydaná (latest.yml), takže nikoho nezablokuje dřív. "off" = nehlídat.
# DESKTOP_MIN_VERSION=0.11.0
# Kine Clipper pro Android (repo kine-mobile): APK mimo Google Play. Výchozí zdroj je
# „plovoucí“ vydání android-latest na GitHubu (build.yml ho obnoví při každém pushi).
# NEXT_PUBLIC_MOBILE_REPO=dezfghzdgz/kine-mobile
# Složka s Kine-Clipper.apk a latest.json v našem úložišti - jen když build.yml v
# kine-mobile do R2 opravdu nahrává (má R2_* secrets a DESKTOP_DOWNLOAD_BASE):
# NEXT_PUBLIC_ANDROID_DOWNLOAD_BASE=https://pub-xxxxxxxx.r2.dev/android
# Přímá adresa APK (přebije vše): NEXT_PUBLIC_ANDROID_DOWNLOAD_URL=https://…/Kine-Clipper.apk

# Platby přes Stripe (Kine Plus, dary, předplatné tvůrců). Podrobný postup
# je v návodu "Stripe a spuštění naostro". Stripe -> Developers -> API keys ->
# Secret key (sk_test_… v testovacím režimu, sk_live_… naostro). Jen sem
# a do Vercelu, nikdy do GitHubu.
# STRIPE_SECRET_KEY=sk_test_xxx
# Stripe -> Developers -> Webhooks -> Add endpoint:
#   https://<tvůj web>/api/donate/webhook
#   události: checkout.session.completed, checkout.session.async_payment_succeeded,
#   customer.subscription.updated, customer.subscription.deleted,
#   charge.dispute.created  ->  "Signing secret" (whsec_…) sem:
# STRIPE_WEBHOOK_SECRET=whsec_xxx

# Předplatné - tři varianty (lib/plus.ts). Ve Stripe: Product catalog ->
# Add product, cena měsíční (recurring) -> zkopíruj ID ceny (price_…).
# Bez ceny se varianta nedá koupit, ale admin ji může dát ručně (/admin/plus).
#   Kine Plus         web: odznak PLUS, 3x víc nahrávání (počet, délka, úložiště)
#   Klipy Plus        appka: automatické nahrávání klipů po hře, klipy až 5 minut
#   Kine Plus + Klipy obojí (starší STRIPE_PLUS_PRICE_ID znamená tuhle variantu)
# STRIPE_PLUS_KINE_PRICE_ID=price_xxx
# STRIPE_PLUS_CLIPS_PRICE_ID=price_xxx
# STRIPE_PLUS_ALL_PRICE_ID=price_xxx
# Ceny, jak se ukazují lidem (jen text):
# NEXT_PUBLIC_PLUS_KINE_PRICE_LABEL=49 Kč / měsíc
# NEXT_PUBLIC_PLUS_CLIPS_PRICE_LABEL=79 Kč / měsíc
# NEXT_PUBLIC_PLUS_ALL_PRICE_LABEL=99 Kč / měsíc

# Placené věci (Kine Plus, Podpořit Kine, předplatné kanálu) jsou schované,
# dokud tohle není 1 (lib/payments.ts). Po změně Redeploy.
# NEXT_PUBLIC_PAYMENTS=1
