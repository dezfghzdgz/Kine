# Supabase - najdeš v Supabase dashboardu -> Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Skutečná veřejná adresa appky (až bude appka nasazená) - appka to
# potřebuje pro sitemapu a náhledy odkazů. Do té doby klidně nech
# na http://localhost:3000.
NEXT_PUBLIC_SITE_URL=https://tvoje-domena.cz

# Cloudflare Stream - najdeš v Cloudflare dashboardu -> Stream
CLOUDFLARE_ACCOUNT_ID=your-account-id
CLOUDFLARE_STREAM_API_TOKEN=your-api-token

# Vlastní přehrávač hudby bere HLS z domény tvého účtu Cloudflare, kterou si
# sám přečte z adresy náhledu (customer-<kód>.cloudflarestream.com). Kdyby
# hudba nehrála, dá se kód nastavit i ručně (jen ten kód, bez "customer-"):
# NEXT_PUBLIC_STREAM_CUSTOMER_CODE=f33zs165nr7gyfy4

# Podepsané adresy pro neveřejná videa (nepovinné). Bez nich se nic
# nepodepisuje a appka se chová jako dřív. Postup, jak klíč vytvořit,
# je v lib/streamProtection.ts.
# CLOUDFLARE_STREAM_KEY_ID=id-podpisoveho-klice
# CLOUDFLARE_STREAM_KEY_PEM=base64-pem-tak-jak-ho-vrati-cloudflare

# GIFy v komentářích (nepovinné, appka bez toho zkusí sdílený klíč, který
# ale Giphy může kdykoliv zablokovat) - zdarma na developers.giphy.com
NEXT_PUBLIC_GIPHY_API_KEY=your-giphy-api-key

# Kolik videí smí jeden účet nahrát za den (nepovinné, výchozí 20). Klipy
# vystřižené z cizích videí se do toho nepočítají, ty mají vlastní limit
# 30 za den (lib/clips.ts). Každá uložená minuta stojí u Cloudflare peníze,
# proto tu nějaký strop je - až bude appka větší, klidně zvedni.
# UPLOAD_DAILY_LIMIT=20

# Appka Kine do PC (Kine jako aplikace + klipy ze hry). Instalátor staví
# GitHub Actions v repu kine-desktop a nahrává ho do našeho úložiště
# (Cloudflare R2) a záložně na GitHub Releases. /download/windows na něj
# pošle prohlížeč rovnou - uživatel nikam nechodí, jen mu začne stahování.
# Veřejná adresa složky v úložišti (tam leží Kine-Setup.exe,
# Kine-Clipper-Setup.exe a latest.yml) - stejná hodnota jako proměnná
# DESKTOP_DOWNLOAD_BASE v GitHubu repa kine-desktop. Bez ní se stahuje z GitHubu.
# NEXT_PUBLIC_DESKTOP_DOWNLOAD_BASE=https://pub-xxxxxxxx.r2.dev
# Když repo přejmenuješ:
# NEXT_PUBLIC_DESKTOP_REPO=dezfghzdgz/kine-desktop
# Přímá adresa jednoho instalátoru (přebije vše; druhý název se hledá vedle něj):
# NEXT_PUBLIC_DESKTOP_DOWNLOAD_URL=https://…/Kine-Setup.exe

# Předplatné - tři varianty (lib/plus.ts). Ve Stripe: Product catalog ->
# Add product, cena měsíční (recurring) -> zkopíruj ID ceny (price_…).
# Bez ceny se varianta nedá koupit, ale admin ji může dát ručně (/admin/plus).
#   Kine Plus         web: odznak PLUS, 3x vyšší denní limit nahrávání
#   Klipy Plus        appka: automatické nahrávání klipů po hře, klipy až 5 minut
#   Kine Plus + Klipy obojí (starší STRIPE_PLUS_PRICE_ID znamená tuhle variantu)
# STRIPE_PLUS_KINE_PRICE_ID=price_xxx
# STRIPE_PLUS_CLIPS_PRICE_ID=price_xxx
# STRIPE_PLUS_ALL_PRICE_ID=price_xxx
# Ceny, jak se ukazují lidem (jen text):
# NEXT_PUBLIC_PLUS_KINE_PRICE_LABEL=49 Kč / měsíc
# NEXT_PUBLIC_PLUS_CLIPS_PRICE_LABEL=79 Kč / měsíc
# NEXT_PUBLIC_PLUS_ALL_PRICE_LABEL=99 Kč / měsíc
